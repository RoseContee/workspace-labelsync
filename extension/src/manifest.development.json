{
  "manifest_version": 3,
  "name": "Workspace Labelsync",
  "description": "Sync your label contacts in Google Workspace",
  "version": "1.0.0",
  "background": {
    "service_worker": "/background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://admin.labelsync.it/*", "http://localhost:8000/*"],
  "permissions": ["identity", "storage", "alarms"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
